TRIGGER_SECRET_KEY=

# Required. Dev HQ APIs deny every request unless this is exactly `local`.
# This is suitable only for a trusted local environment; it is not an
# authentication mechanism and must not be enabled on an internet-reachable host.
DEV_HQ_DEPLOYMENT_MODE=local

# Required. Shared secret for Trigger.dev worker callbacks into
# /api/dev-hq/internal/*. Those routes fail closed with 503 when this is unset.
# The Trigger.dev dev CLI loads .env.local too, so both processes see the value.
DEV_HQ_INTERNAL_TOKEN=
